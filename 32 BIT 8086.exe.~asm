; 8086 – 32-BIT ADDITION

DATA SEGMENT
NUM1 DW 1234H, 5678H
NUM2 DW 1111H, 2222H
RES  DW 3 DUP(0)
DATA ENDS

CODE SEGMENT
ASSUME CS:CODE, DS:DATA

START:
MOV AX, DATA
MOV DS, AX

MOV AX, NUM1
ADD AX, NUM2
MOV RES, AX

MOV AX, NUM1+2
ADC AX, NUM2+2
MOV RES+2, AX

MOV AX, 0000H
ADC AX, 0000H
MOV RES+4, AX

MOV AH, 4CH
INT 21H

CODE ENDS
END START

